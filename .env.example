# Copy to .env.local for local development. .env.local is gitignored.
#
# Nothing here is VITE_-prefixed, on purpose. Vite inlines VITE_ variables into the
# browser bundle, and the browser never needs any of these: it only talks to /api, and
# the API is the only thing that talks to Supabase. Set the same names in the Vercel
# project's environment variables for deploys.

# --- Supabase ---------------------------------------------------------------
# The Tech League's OWN project, not the member portal's. Separate on purpose: different
# data, different keys, different blast radius.
# Locally: `npx supabase start`, then copy API_URL, PUBLISHABLE_KEY and SECRET_KEY from
# `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where links in emails point. No trailing slash.
APP_URL=http://localhost:5175

# --- Sign in with ColorStack at GSU ------------------------------------------
# Registered in cs-gsu_backend (application.yml, app.oidc.clients). The redirect URI is
# matched literally, port and path included, and must equal what the portal has set as
# TECH_LEAGUE_REDIRECT_URI. Leave these empty to switch the ColorStack button off.
COLORSTACK_ISSUER=https://api.colorstackatgsu.com
COLORSTACK_CLIENT_ID=tech-league
COLORSTACK_CLIENT_SECRET=
COLORSTACK_REDIRECT_URI=http://localhost:5175/api/auth/callback

# --- Email --------------------------------------------------------------------
# Production sends through Gmail's API as the chapter mailbox, with the same service
# account and domain-wide delegation (gmail.send) the member portal uses. Both empty
# prints emails to the terminal instead, which is how you click a confirmation link
# locally. Production refuses to start sending without them.
GMAIL_SEND_AS=
# The service account key file's contents, as one line of JSON.
GOOGLE_CREDENTIALS_JSON=
# MAIL_FROM=ColorStack at GSU <official@colorstackatgsu.com>
